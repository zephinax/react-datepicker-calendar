{
  "name": "@zephinax/react-datepicker-calendar",
  "version": "1.2.0",
  "description": "A modern, customizable React date picker with smooth animations, responsive design, and easy integration.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://react-datepicker-calendar.zephinax.com",
  "bugs": {
    "url": "https://github.com/zephinax/react-datepicker-calendar/issues",
    "email": "zephinax@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zephinax/react-datepicker-calendar.git",
    "directory": "/"
  },
  "workspaces": [
    "playground"
  ],
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/zephinax"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepublishOnly": "npm run build && npm test && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist lib",
    "playground:dev": "bun --cwd playground dev",
    "playground:build": "bun --cwd playground build",
    "playground:deploy": "bun --cwd playground run deploy"
  },
  "author": {
    "name": "Zephinax",
    "email": "zephinax@gmail.com",
    "url": "https://github.com/zephinax"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "modern",
    "calendar",
    "datepicker",
    "datepicker range",
    "datepicker component",
    "beautiful",
    "animated",
    "persian",
    "jalali",
    "typescript"
  ],
  "dependencies": {
    "jalaali-js": "^1.2.7"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
